DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
# The host Nginx serves the API on, e.g. api-test.phloz.app
DJANGO_ALLOWED_HOSTS=api-test.phloz.app,localhost
# The console origin that calls this API
CORS_ALLOWED_ORIGINS=https://track.phloz.app
POSTGRES_HOST=fms-db
POSTGRES_PORT=5432
POSTGRES_DB=phloz_fms
POSTGRES_USER=phloz
POSTGRES_PASSWORD=replace-with-a-strong-password

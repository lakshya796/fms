DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
# The host Nginx serves the API on, e.g. api-test.phloz.app
DJANGO_ALLOWED_HOSTS=api-test.phloz.app,localhost
# Frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=https://track.phloz.app,https://main.d12iaal63qqmzf.amplifyapp.com
# Amplify puts every branch on its own subdomain, so a fixed list above breaks
# on each new branch deploy. Anchor patterns at both ends and scope them to one
# Amplify app id - unanchored, they would also match a lookalike domain.
CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+[.]d12iaal63qqmzf[.]amplifyapp[.]com$
POSTGRES_HOST=fms-db
POSTGRES_PORT=5432
POSTGRES_DB=phloz_fms
POSTGRES_USER=phloz
POSTGRES_PASSWORD=replace-with-a-strong-password
# Private S3 bucket used for ePOD and other fleet document uploads. The API
# reads AWS credentials from the EC2 instance role / standard boto3 chain.
FMS_S3_BUCKET=phlozmedia
FMS_S3_REGION=ap-south-1
